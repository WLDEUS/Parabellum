<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template rendered by scripts/build-app.sh. Placeholders:
    @VERSION@       [workspace.package] version of Cargo.toml
    @BUILD_NUMBER@  git commit count, or UTC date on shallow clones
    @YEAR@          build year
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>fr</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>fr</string>
		<string>en</string>
	</array>
	<key>CFBundleIdentifier</key>
	<string>com.wldeus.parabellum</string>
	<key>CFBundleName</key>
	<string>Parabellum</string>
	<key>CFBundleDisplayName</key>
	<string>Parabellum</string>
	<key>CFBundleExecutable</key>
	<string>Parabellum</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@BUILD_NUMBER@</string>
	<key>CFBundleSupportedPlatforms</key>
	<array>
		<string>MacOSX</string>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSArchitecturePriority</key>
	<array>
		<string>arm64</string>
	</array>
	<key>LSUIElement</key>
	<true/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- parabellum:// links (Shortcuts "Ouvrir l'URL", scripts): parsed strictly by ParabellumURL.parse. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.wldeus.parabellum.actions</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>parabellum</string>
			</array>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
		</dict>
	</array>
	<!-- Finder › clic droit › Actions rapides / Services (also in the Finder extension's submenu). Titles
	     translated in <lang>.lproj/ServicesMenu.strings. Handled by ServicesProvider. -->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Analyser avec Parabellum</string>
			</dict>
			<key>NSMessage</key>
			<string>scanFiles</string>
			<key>NSPortName</key>
			<string>Parabellum</string>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.item</string>
			</array>
		</dict>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Nettoyer les métadonnées (Parabellum)</string>
			</dict>
			<key>NSMessage</key>
			<string>cleanMetadata</string>
			<key>NSPortName</key>
			<string>Parabellum</string>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Chiffrer avec Parabellum</string>
			</dict>
			<key>NSMessage</key>
			<string>encryptFolder</string>
			<key>NSPortName</key>
			<string>Parabellum</string>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.folder</string>
			</array>
		</dict>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Supprimer définitivement (Parabellum)</string>
			</dict>
			<key>NSMessage</key>
			<string>shredFiles</string>
			<key>NSPortName</key>
			<string>Parabellum</string>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.item</string>
			</array>
		</dict>
	</array>
	<!-- Folders encrypted from the Finder: `<nom>.coffre` packages (encrypted disk image + keys.json),
	     opened by Parabellum on double-click (Touch ID, password or key file). -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.wldeus.parabellum.coffre</string>
			<key>UTTypeDescription</key>
			<string>Dossier chiffré Parabellum</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.apple.package</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>coffre</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Dossier chiffré Parabellum</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSTypeIsPackage</key>
			<true/>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.wldeus.parabellum.coffre</string>
			</array>
		</dict>
	</array>
	<!-- Travel mode can turn Bluetooth off (opt-in, IOBluetooth): required by TCC to touch Bluetooth. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Le mode Voyage peut couper le Bluetooth pendant vos déplacements, puis le rallumer.</string>
	<key>NSHumanReadableCopyright</key>
	<string>© @YEAR@ Deus. Logiciel libre sous licence MIT.</string>
</dict>
</plist>
