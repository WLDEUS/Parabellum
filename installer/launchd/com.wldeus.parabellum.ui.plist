<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Installed as /Library/LaunchAgents/com.wldeus.parabellum.ui.plist (root:wheel 0644).
  Starts the menu bar app in every GUI (Aqua) session; relaunched after a crash, not after "Quitter".
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.wldeus.parabellum.ui</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Applications/Parabellum.app/Contents/MacOS/Parabellum</string>
	</array>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.wldeus.parabellum</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
