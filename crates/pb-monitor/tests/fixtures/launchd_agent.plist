<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.example.updater</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/q/Library/Application Support/Example/updater</string>
		<string>--background</string>
		<string>--silent</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
